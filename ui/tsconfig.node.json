{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "vitest.config.mts"
  ]
}